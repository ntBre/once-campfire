# Copy this file to .env on the deployment host and replace every placeholder.
# The real .env is intentionally ignored by Git and is not used by compose.dev.yaml.
SECRET_KEY_BASE=your_secret_key_base
VAPID_PUBLIC_KEY=your_public_key
VAPID_PRIVATE_KEY=your_private_key
TLS_DOMAIN=chat.example.com
SENTRY_DSN=
